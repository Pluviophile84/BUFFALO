---
import { STATEMENT } from '../content/copy';
import PlateLabel from '../components/PlateLabel.astro';
import brand from '../data/brand.json';
---
<section class="section statement" id="statement" aria-labelledby="statement-label">
  <div class="wrap">
    <PlateLabel text={STATEMENT.label} center id="statement-label" as="h2" />
    <div class="statement__text">
      {STATEMENT.lines.map((l, i) => <p data-ink data-stagger={String(Math.min(i, 5))}>{l}</p>)}
    </div>
    <p class="statement__sig label">
      {/* The Ƀ from the extracted vector (public/brand/b-symbol.svg: same path, viewBox
          tight to its bounding box), as its own block, so the ring centres the glyph's
          bounding box, as the master logo centres it, not a text line box. */}
      <span class="seal" aria-hidden="true"><svg class="seal__b" viewBox={brand.b.baked.viewBox} focusable="false"><path fill-rule="evenodd" d={brand.b.baked.d} /></svg></span>
      <span>{STATEMENT.signature}</span>
    </p>
  </div>
</section>
