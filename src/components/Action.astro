---
// A link-styled action. Disabled actions render <a aria-disabled="true"> with no
// href (so they cannot be followed or tabbed to) and visible helper text.
interface Props {
  href?: string | null;
  label: string;
  primary?: boolean;
  helper?: string;
  external?: boolean;
  class?: string;
  /** Required for a disabled action with helper text: names its aria-describedby target. */
  id?: string;
}
const { href, label, primary = false, helper, external = false, class: cls = '', id } = Astro.props;
const disabled = !href;
// Stable per-instance id for aria-describedby, given by the caller (no global
// counter: the same markup on every build and every render, in any order).
if (disabled && helper && !id) throw new Error(`Action "${label}": a disabled action with helper text needs an id`);
const hid = disabled && helper ? `help-${id}` : undefined;
---
{disabled ? (
  <span class:list={['action', cls]}>
    <a class:list={['btn', primary && 'btn--primary']} role="link" aria-disabled="true" aria-describedby={hid}>
      {label}
    </a>
    {helper && <span class="helper" id={hid}>{helper}</span>}
  </span>
) : (
  <a
    class:list={['btn', primary && 'btn--primary', cls]}
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    data-external={external ? '' : undefined}
  >
    {label}
  </a>
)}
