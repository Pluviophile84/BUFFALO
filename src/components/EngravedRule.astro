---
// Engraved section rule: tapering hairlines echoing the ground raster.
// Read from afar it is a line; drawn via stroke-dashoffset on reveal.
interface Props {
  lines?: 3 | 4 | 5;
  align?: 'center' | 'left';
  class?: string;
  ink?: boolean;
}
const { lines = 5, align = 'center', class: cls = '', ink = false } = Astro.props;
const lengths = [1, 0.82, 0.62, 0.42, 0.22].slice(0, lines);
const opac = [0.32, 0.24, 0.18, 0.13, 0.09];
const W = 1000;
---
<svg class:list={['engraved-rule', `engraved-rule--${lines}`, ink && 'engraved-rule--ink', cls]} viewBox={`0 0 ${W} ${lines * 4 - 3}`} preserveAspectRatio="none" aria-hidden="true" focusable="false" data-draw>
  {lengths.map((l, i) => {
    const len = W * l;
    const x1 = align === 'center' ? (W - len) / 2 : 0;
    return <line x1={x1} x2={x1 + len} y1={i * 4 + 0.5} y2={i * 4 + 0.5} stroke-opacity={opac[i]} pathLength="1" />;
  })}
</svg>
