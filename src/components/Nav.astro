---
import { issue } from '../lib/issue-state';
import { NAV, HERO } from '../content/copy';
import brand from '../data/brand.json';
import Action from './Action.astro';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const prefix = home ? '' : '/';
const pill = issue.live ? 'In circulation' : 'Pre-issue';
---
<header class="nav" id="nav">
  <div class="wrap nav__bar">
    <a class="wordmark" href={home ? '#top' : '/'} aria-label="BUFFALO, home">
      <svg class="wordmark__b" viewBox={brand.b.baked.viewBox} aria-hidden="true" focusable="false"><path fill="#EEE1C6" fill-rule="evenodd" d={brand.b.baked.d} /></svg>
      <span class="wordmark__text" aria-hidden="true">BUFFALO</span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      {NAV.links.map((l) => <a href={`${prefix}${l.href}`}>{l.label}</a>)}
    </nav>
    <div class="nav__right">
      <span class:list={['pill', issue.live && 'pill--live']}><span class="pill__dot" aria-hidden="true"></span><span class="vh">Status: </span>{pill}</span>
      <button class="nav__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-open hidden>
        <span class="nav__menu-icon" aria-hidden="true"></span>Menu
      </button>
      {/* Navigation without JavaScript (disabled, or the script blocked or failed):
          a native disclosure with the section links. scripts/nav.ts removes it
          first thing and shows the overlay menu's button in its place (same box,
          so nothing moves), so with JavaScript the menu is exactly as before. */}
      <details class="nav__fallback" data-nav-fallback>
        <summary class="nav__menu"><span class="nav__menu-icon" aria-hidden="true"></span><span class="nav__fallback-open">Menu</span><span class="nav__fallback-close">Close</span></summary>
        <nav class="nav__fallback-links" aria-label="Sections">
          {NAV.links.map((l) => <a href={`${prefix}${l.href}`}>{l.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
  <div class="menu__bar">
    <span class="wordmark" aria-hidden="true">
      <svg class="wordmark__b" viewBox={brand.b.baked.viewBox} focusable="false"><path fill="#EEE1C6" fill-rule="evenodd" d={brand.b.baked.d} /></svg>
      <span class="wordmark__text">BUFFALO</span>
    </span>
    <button class="nav__menu" type="button" data-menu-close>Close</button>
  </div>
  <nav class="menu__links" aria-label="Sections">
    {NAV.links.map((l) => <a href={`${prefix}${l.href}`} data-menu-link>{l.label}</a>)}
  </nav>
  <div class="menu__foot">
    {/* live: the hero's primary action; pre-issue: none (no dead button) */}
    {issue.live && <Action href={issue.buyUrl} label={HERO.buy} primary external />}
    <span class:list={['pill', issue.live && 'pill--live']}><span class="pill__dot" aria-hidden="true"></span>{pill}</span>
  </div>
</div>
