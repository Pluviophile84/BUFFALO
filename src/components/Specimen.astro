---
// Pre-issue marks (§3.5 D). Rendered only in the pre-issue state.
//  • overprint — diagonal SPECIMEN with a double-ruled box, over the serial module
//  • stamp     — SPECIMEN · PRE-ISSUE, beside the hero coin, never over the artwork
interface Props {
  kind: 'overprint' | 'stamp';
  class?: string;
}
const { kind, class: cls = '' } = Astro.props;
---
{kind === 'overprint' ? (
  <svg class:list={['serial__specimen', cls]} viewBox="0 0 300 66" aria-hidden="true" focusable="false" data-specimen>
    <rect x="1" y="1" width="298" height="64" />
    <rect x="6" y="6" width="288" height="54" />
    <text x="150" y="44" text-anchor="middle">SPECIMEN</text>
  </svg>
) : (
  <span class:list={['stamp', cls]} aria-hidden="true" data-specimen><span class="stamp__one">SPECIMEN · PRE-ISSUE</span><span class="stamp__two"><span class="stamp__line">SPECIMEN</span><span class="stamp__line">PRE-ISSUE</span></span></span>
)}
